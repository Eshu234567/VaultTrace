# MongoDB Connection URI
# Use MongoDB Atlas URI for Vercel deployment or mongodb://127.0.0.1:27017/vaulttrace_db for local MongoDB
# If omitted locally, the server automatically starts an embedded MongoDB instance and seeds realistic campus data!
MONGODB_URI=mongodb://127.0.0.1:27017/vaulttrace_db

# Authentication
JWT_SECRET=vaulttrace-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
